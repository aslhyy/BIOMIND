rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['Administrador', 'admin'];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Reglas abiertas temporalmente para pruebas integrales de Fase 10.
    // Permiten validar CRUD, asignaciones y trimestres con cualquier usuario autenticado.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    match /usuarios/{userId} {
      allow list: if isAdmin()
        || (request.auth != null && request.query.limit <= 1);

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.correo == request.auth.token.email;

      allow read: if isOwner(userId) || isAdmin();

      allow update: if (
          isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol'])
        )
        || isAdmin();
    }

    match /identificacionesRegistro/{identificacionId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.identificacion == identificacionId;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    match /programas/{programaId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
    }

    match /fichas/{fichaId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
    }

    match /trimestres/{trimestreId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
    }
  }
}
